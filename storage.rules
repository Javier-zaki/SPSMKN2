rules_version = '2';

// SPSMKN2 Storage rules — complaint evidence and result attachments.
// Layout: /complaints/{complaintId}/{fileName}
//
// Uploads are restricted by size and MIME type here as a second layer; the
// app also validates file type/size client-side and server-side before
// generating upload URLs.

service firebase.storage {
  match /b/{bucket}/o {
    match /complaints/{complaintId}/{fileName} {
      allow read: if request.auth != null; // narrowed further by app logic
                                            // via signed access checks tied
                                            // to the complaint's participants
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
      allow delete: if false;
    }
  }
}
